// Multi-vendor marketplace — PostgreSQL schema (Prisma)
// Core domain: User, Business, Product, Order, Review, Category
// Supporting: OrderItem, OrderVendor, ProductImage (required for production scale)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  MANAGER
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessStatus {
  PENDING
  RECOMMENDED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  OUT_OF_STOCK
}

/// Customer-facing checkout order (may span multiple vendors).
enum OrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

/// Per-vendor fulfillment slice of a checkout order.
enum VendorOrderStatus {
  PLACED
  ACCEPTED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  COD
  WALLET
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String?    @map("last_name") @db.VarChar(100)
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  businesses Business[] @relation("BusinessOwner")
  orders     Order[]    @relation("CustomerOrders")
  reviews    Review[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ─────────────────────────────────────────────
// Category (self-referential tree)
// ─────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String? @db.Text
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businesses Business[]
  products   Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

// ─────────────────────────────────────────────
// Business (vendor storefront)
// ─────────────────────────────────────────────

model Business {
  id          String         @id @default(cuid())
  name        String         @map("name") @db.VarChar(200)
  slug        String         @unique @db.VarChar(220)
  description String?        @db.Text
  logoUrl     String?        @map("logo_url")
  coverUrl    String?        @map("cover_url")
  email       String?        @db.VarChar(191)
  phone       String         @db.VarChar(20)
  website     String?

  // Location
  addressLine1 String  @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @map("postal_code") @db.VarChar(20)
  country      String  @default("IN") @db.VarChar(2)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)

  // Compliance
  gstNumber          String? @map("gst_number") @db.VarChar(50)
  registrationNumber String? @map("registration_number") @db.VarChar(100)

  isFeatured Boolean        @default(false) @map("is_featured")
  isVerified Boolean        @default(false) @map("is_verified")
  status     BusinessStatus @default(PENDING)

  ownerId    String  @map("owner_id")
  owner      User    @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId String? @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products     Product[]
  vendorOrders OrderVendor[]
  reviews      Review[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([isFeatured, status])
  @@map("businesses")
}

// ─────────────────────────────────────────────
// Product
// ─────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(200)
  slug        String        @db.VarChar(220)
  description String?       @db.Text
  sku         String?       @db.VarChar(100)

  /// Base price in minor-independent decimal (e.g. INR rupees).
  price     Decimal  @db.Decimal(12, 2)
  salePrice Decimal? @map("sale_price") @db.Decimal(12, 2)
  currency  String   @default("INR") @db.VarChar(3)

  stock     Int           @default(0)
  status    ProductStatus @default(DRAFT)
  viewCount Int           @default(0) @map("view_count")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

// ─────────────────────────────────────────────
// Order (checkout) → OrderVendor (per shop) → OrderItem
// ─────────────────────────────────────────────

/// Parent checkout order placed by a customer (can include multiple vendors).
model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique @map("order_number") @db.VarChar(40)
  status      OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod PaymentMethod @map("payment_method")

  /// Snapshot totals at checkout time.
  subtotal       Decimal @db.Decimal(12, 2)
  shippingTotal  Decimal @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal     Decimal @map("grand_total") @db.Decimal(12, 2)
  currency       String  @default("INR") @db.VarChar(3)

  /// Shipping snapshot (immutable after place).
  shippingName    String  @map("shipping_name") @db.VarChar(150)
  shippingPhone   String  @map("shipping_phone") @db.VarChar(20)
  shippingLine1   String  @map("shipping_line1") @db.VarChar(255)
  shippingLine2   String? @map("shipping_line2") @db.VarChar(255)
  shippingCity    String  @map("shipping_city") @db.VarChar(100)
  shippingState   String? @map("shipping_state") @db.VarChar(100)
  shippingPostal  String? @map("shipping_postal") @db.VarChar(20)
  shippingCountry String  @default("IN") @map("shipping_country") @db.VarChar(2)

  notes String? @db.Text

  customerId String @map("customer_id")
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendorOrders OrderVendor[]
  items        OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// One fulfillment unit per vendor inside a multi-vendor checkout.
model OrderVendor {
  id     String            @id @default(cuid())
  status VendorOrderStatus @default(PLACED)

  subtotal          Decimal @db.Decimal(12, 2)
  shippingAmount    Decimal @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  commissionAmount  Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)
  vendorPayout      Decimal @default(0) @map("vendor_payout") @db.Decimal(12, 2)
  trackingNumber    String? @map("tracking_number") @db.VarChar(100)

  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@unique([orderId, businessId])
  @@index([businessId])
  @@index([status])
  @@map("order_vendors")
}

/// Line item with price/name snapshot (survives product edits/deletes).
model OrderItem {
  id String @id @default(cuid())

  productName String  @map("product_name") @db.VarChar(200)
  sku         String? @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderVendorId String      @map("order_vendor_id")
  orderVendor   OrderVendor @relation(fields: [orderVendorId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([orderVendorId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// Review
// ─────────────────────────────────────────────

model Review {
  id      String       @id @default(cuid())
  rating  Int // 1–5; enforce in app / DB check constraint later
  title   String?      @db.VarChar(150)
  comment String?      @db.Text
  status  ReviewStatus @default(PENDING)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Denormalized for business-level rating aggregates / moderation.
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([productId])
  @@index([businessId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}
