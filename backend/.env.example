# Environment Variables — Backend

PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email — Resend (recommended for small testing) OR classic SMTP
# Resend free tier: set EMAIL_PROVIDER=resend and RESEND_API_KEY
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=LocalMart <onboarding@resend.dev>
# After you verify your domain in Resend, change EMAIL_FROM to noreply@yourdomain.com

# SMTP alternative (set EMAIL_PROVIDER=smtp and fill these)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# SMS API (BOTH URL and KEY required for real SMS)
# Leave empty for Dev OTP mode (OTP returned in API response / UI).
# Example (generic HTTP SMS gateway — must match your provider docs):
# SMS_API_URL=https://your-sms-provider.com/api/send
# SMS_API_KEY=your_real_api_key
# SMS_SENDER_ID=LOCALMART
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# Payment Gateway
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=

# File storage
# Now: cloudinary | After deploy: digitalocean
STORAGE_PROVIDER=cloudinary
MAX_FILE_SIZE=10485760

# Cloudinary (active)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DigitalOcean Spaces (post-deploy)
# STORAGE_PROVIDER=digitalocean
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_URL=

# Commission (default %)
DEFAULT_COMMISSION_RATE=5

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Google Sign-In (same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
