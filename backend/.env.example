# Environment Variables — Backend

PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email API
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@marketplace.com

# SMS API
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# Payment Gateway
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=

# File storage
# Now: cloudinary | After deploy: digitalocean
STORAGE_PROVIDER=cloudinary
MAX_FILE_SIZE=10485760

# Cloudinary (active)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DigitalOcean Spaces (post-deploy)
# STORAGE_PROVIDER=digitalocean
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_URL=

# Commission (default %)
DEFAULT_COMMISSION_RATE=5

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
